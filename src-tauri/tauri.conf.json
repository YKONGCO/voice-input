{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceInput",
  "version": "1.0.0",
  "identifier": "com.voiceinput.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceInput",
        "label": "main",
        "width": 280,
        "height": 350,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "fullscreen": false,
        "maximizable": false,
        "alwaysOnTop": false,
        "url": "index.html",
        "transparent": true
      }
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
